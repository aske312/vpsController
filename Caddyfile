{
    # UDP/443 is reserved for AmneziaWG, so keep HTTPS on TCP (HTTP/1.1 and HTTP/2).
    servers {
        protocols h1 h2
    }
}

{$SITE_ADDRESS} {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    handle /api/mihomo/* {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/protocols/mihomo/status {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}

http://{WG_PANEL_ADDRESS}, http://{AWG_PANEL_ADDRESS} {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    handle /api/mihomo/* {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/protocols/mihomo/status {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
