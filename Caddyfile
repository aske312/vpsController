{
    # UDP/443 is reserved for AmneziaWG, so keep HTTPS on TCP (HTTP/1.1 and HTTP/2).
    servers {
        protocols h1 h2
    }
}

{$SITE_ADDRESS} {
    route {
    # Also understood by older release installers: the protected site uses localhost.
    @outsidePanel {
        host localhost
        not path /s/* /api/mihomo/subscriptions/*
        not remote_ip 127.0.0.0/8 ::1/128 {PUBLIC_PANEL_ADDRESS} 10.82.0.0/24 10.83.0.0/24
    }
    respond @outsidePanel 403
    header -X-Powered-By
    handle /s/* {
        reverse_proxy 127.0.0.1:8791
    }
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    handle /api/mihomo/* {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/protocols/mihomo/status {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
    }
}

http://10.82.0.1, http://10.83.0.1 {
    route {
    @outsideProtectedConnection {
        not path /s/* /api/mihomo/subscriptions/*
        not remote_ip 127.0.0.0/8 ::1/128 {PUBLIC_PANEL_ADDRESS} 10.82.0.0/24 10.83.0.0/24
    }
    respond @outsideProtectedConnection 403
    header -X-Powered-By
    handle /s/* {
        reverse_proxy 127.0.0.1:8791
    }
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    handle /api/mihomo/* {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/protocols/mihomo/status {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
    }
}

# Stable panel address for full tunnels and HTTP/SOCKS proxy connections.
http://{INTERNAL_PANEL_HOST}, http://{PUBLIC_PANEL_ADDRESS} {
    route {
    @outsideProtectedConnection {
        not path /s/* /api/mihomo/subscriptions/*
        not remote_ip 127.0.0.0/8 ::1/128 {PUBLIC_PANEL_ADDRESS} 10.82.0.0/24 10.83.0.0/24
    }
    respond @outsideProtectedConnection 403
    header -X-Powered-By
    handle /s/* {
        reverse_proxy 127.0.0.1:8791
    }
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    handle /api/mihomo/* {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/protocols/mihomo/status {
        reverse_proxy 127.0.0.1:8791
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
    }
}

# Protocol images may add isolated virtual hosts here. A glob with no matches
# is valid, so a clean installation does not need placeholder configuration.
import /etc/caddy/vps-control.d/*.caddy
