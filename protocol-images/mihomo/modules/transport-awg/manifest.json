{
  "id": "transport-awg",
  "name": "AmneziaWG",
  "version": "1.0.0",
  "installable": true,
  "description": "Сервер AmneziaWG для подключений Mihomo.",
  "category": "transport",
  "category_name": "Каналы",
  "default_enabled": false,
  "scope": "mihomo",
  "service": "awg-quick@mh-awg0.service",
  "supported_os": [
    "ubuntu",
    "debian"
  ],
  "preflight_packages": [
    "ca-certificates",
    "curl",
    "dirmngr",
    "dkms",
    "gnupg",
    "iptables"
  ],
  "minimum_free_mb": 256,
  "requires_kernel_headers": true,
  "package": "amneziawg",
  "settings": [
    {
      "key": "port",
      "label": "UDP-порт",
      "type": "number",
      "default": 51831,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "subnet",
      "label": "Подсеть",
      "type": "text",
      "default": "10.83.0.0/24"
    },
    {
      "key": "mtu",
      "label": "MTU серверного интерфейса",
      "type": "number",
      "default": 1280,
      "min": 1280,
      "max": 1420
    },
    {
      "key": "jc",
      "label": "Jc сервера",
      "type": "number",
      "default": 6,
      "help": "Исходящие шумовые пакеты серверного интерфейса. Клиент настраивается отдельно в профиле."
    },
    {
      "key": "jmin",
      "label": "Jmin сервера",
      "type": "number",
      "default": 8,
      "help": "Исходящие шумовые пакеты серверного интерфейса. Клиент настраивается отдельно в профиле."
    },
    {
      "key": "jmax",
      "label": "Jmax сервера",
      "type": "number",
      "default": 80,
      "help": "Исходящие шумовые пакеты серверного интерфейса. Клиент настраивается отдельно в профиле."
    },
    {
      "key": "s1",
      "label": "S1",
      "type": "number",
      "default": 64
    },
    {
      "key": "s2",
      "label": "S2",
      "type": "number",
      "default": 112
    },
    {
      "key": "h1",
      "label": "H1",
      "type": "number",
      "default": 150000000
    },
    {
      "key": "h2",
      "label": "H2",
      "type": "number",
      "default": 600000000
    },
    {
      "key": "h3",
      "label": "H3",
      "type": "number",
      "default": 1000000000
    },
    {
      "key": "h4",
      "label": "H4",
      "type": "number",
      "default": 1400000000
    }
  ],
  "connection_settings": [
    {
      "key": "mtu",
      "label": "MTU клиента",
      "type": "number",
      "default": 1280,
      "min": 1280,
      "max": 1420,
      "help": "Размер пакета на устройстве. Серверный интерфейс настраивается в Компонентах."
    },
    {
      "key": "keepalive",
      "label": "Keepalive клиента, с",
      "type": "number",
      "default": 25,
      "min": 0,
      "max": 120,
      "help": "0 — отключить. Поддерживает NAT-сопоставление при простое."
    },
    {
      "key": "ip_version",
      "label": "IP-версия подключения",
      "type": "select",
      "default": "dual",
      "formats": [
        "mihomo"
      ],
      "export_key": "ip-version",
      "help": "Для клиента Mihomo. ",
      "options": [
        "dual",
        "ipv4",
        "ipv6",
        "ipv4-prefer",
        "ipv6-prefer"
      ]
    },
    {
      "key": "jc",
      "label": "Jc клиента: число шумовых пакетов",
      "type": "number",
      "default": 6,
      "min": 0,
      "max": 128,
      "help": "Параметр исходящих шумовых пакетов этого устройства; не обязан совпадать с сервером."
    },
    {
      "key": "jmin",
      "label": "Jmin клиента: минимальный шумовой пакет",
      "type": "number",
      "default": 8,
      "min": 0,
      "max": 1280,
      "help": "Параметр исходящих шумовых пакетов этого устройства; не обязан совпадать с сервером."
    },
    {
      "key": "jmax",
      "label": "Jmax клиента: максимальный шумовой пакет",
      "type": "number",
      "default": 80,
      "min": 0,
      "max": 1280,
      "help": "Параметр исходящих шумовых пакетов этого устройства; не обязан совпадать с сервером."
    }
  ]
}
