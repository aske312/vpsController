{
  "id": "transport-reality",
  "name": "VLESS",
  "version": "1.1.0",
  "installable": true,
  "description": "Ядро VLESS/REALITY для независимых подключений профиля с XHTTP, RAW, gRPC и CDN.",
  "category": "transport",
  "category_name": "Компоненты",
  "default_enabled": false,
  "scope": "mihomo",
  "supported_os": ["ubuntu", "debian"],
  "preflight_packages": ["ca-certificates", "curl", "iptables", "openssl", "unzip"],
  "minimum_free_mb": 256,
  "requires_kernel_headers": false,
  "settings": [
    {
      "key": "port_start",
      "label": "Начальный Direct-порт",
      "type": "number",
      "default": 9443,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "cdn_port_start",
      "label": "Начальный внутренний CDN-порт",
      "type": "number",
      "default": 10443,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "dns",
      "label": "DNS Xray",
      "type": "text",
      "default": "1.1.1.1, 1.0.0.1",
      "help": "Список DNS Xray через запятую."
    },
    {
      "key": "loglevel",
      "label": "Уровень журнала",
      "type": "select",
      "default": "warning",
      "options": ["debug", "info", "warning", "error", "none"]
    }
  ],
  "connection_settings": [
    { "key": "route_mode", "label": "Маршрут", "type": "select", "default": "direct", "options": [{"value":"direct","label":"VLESS"},{"value":"cdn","label":"VLESS CDN"}] },
    { "key": "port", "label": "Direct-порт", "type": "number", "default": 0, "min": 0, "max": 65535, "help": "0 — выбрать свободный порт автоматически." },
    { "key": "target", "label": "REALITY target", "type": "text", "default": "www.intel.com:443" },
    { "key": "transport", "label": "Транспорт VLESS", "type": "select", "default": "xhttp", "options": [{"value":"xhttp","label":"XHTTP"},{"value":"raw","label":"RAW · TCP"},{"value":"grpc","label":"gRPC · HTTP/2"}] },
    { "key": "transport_path", "label": "Путь / service name", "type": "text", "default": "/vless" },
    { "key": "xhttp_mode", "label": "Режим XHTTP", "type": "select", "default": "auto", "options": ["auto", "stream-one", "stream-up", "packet-up"] },
    { "key": "xpadding", "label": "XHTTP padding", "type": "text", "default": "100-1000" },
    { "key": "xmux_concurrency", "label": "Параллелизм XHTTP", "type": "number", "default": 12, "min": 1, "max": 64 },
    { "key": "cdn_enabled", "label": "Добавить CDN-маршрут", "type": "boolean", "default": false },
    { "key": "cdn_domain", "label": "CDN-домен", "type": "text", "default": "" },
    { "key": "cdn_transport", "label": "CDN-транспорт", "type": "select", "default": "websocket", "options": [{"value":"websocket","label":"WebSocket · совместимый"},{"value":"xhttp","label":"XHTTP · рекомендуемый"},{"value":"httpupgrade","label":"HTTPUpgrade · HTTP/1.1"},{"value":"grpc","label":"gRPC · HTTP/2"}] },
    { "key": "cdn_xhttp_mode", "label": "Режим CDN XHTTP", "type": "select", "default": "auto", "options": ["auto", "stream-one", "stream-up", "packet-up"] }
  ]
}
