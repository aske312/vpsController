{
  "id": "transport-reality",
  "name": "VLESS Reality + XHTTP",
  "version": "1.0.0",
  "installable": true,
  "description": "Отдельный Xray/Reality-инстанс для Mihomo-профилей.",
  "category": "transport",
  "category_name": "Каналы",
  "default_enabled": false,
  "scope": "mihomo",
  "supported_os": ["ubuntu", "debian"],
  "preflight_packages": ["ca-certificates", "curl", "iptables", "openssl", "unzip"],
  "minimum_free_mb": 256,
  "requires_kernel_headers": false,
  "settings": [
    {
      "key": "port",
      "label": "TCP-порт",
      "type": "number",
      "default": 9443,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "target",
      "label": "REALITY target",
      "type": "text",
      "default": "www.intel.com:443"
    }
  ]
}
