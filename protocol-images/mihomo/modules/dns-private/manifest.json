{
  "id": "dns-private",
  "name": "Private DNS",
  "version": "1.0.0",
  "installable": false,
  "automatic": true,
  "settings_only": true,
  "description": "DNS-политика для конфигураций Mihomo. Всегда включена, настраивается здесь.",
  "category": "dns",
  "category_name": "DNS",
  "settings": [
    {
      "key": "enhanced_mode",
      "label": "Enhanced mode",
      "type": "select",
      "default": "fake-ip",
      "options": [
        "fake-ip",
        "redir-host"
      ]
    },
    {
      "key": "nameserver",
      "label": "Основной DNS",
      "type": "select",
      "default": "https://cloudflare-dns.com/dns-query"
    },
    {
      "key": "fallback",
      "label": "Резервный DNS",
      "type": "select",
      "default": "https://dns.google/dns-query"
    }
  ]
}
