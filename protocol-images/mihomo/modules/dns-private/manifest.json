{
  "id": "dns-private",
  "name": "Private DNS",
  "version": "1.2.0",
  "installable": false,
  "automatic": true,
  "settings_only": true,
  "description": "DNS-политика для конфигураций Mihomo. Всегда включена, настраивается здесь.",
  "category": "dns",
  "category_name": "DNS",
  "settings": [
    {
      "key": "enhanced_mode",
      "label": "Enhanced mode",
      "type": "select",
      "default": "fake-ip",
      "options": [
        "fake-ip",
        "redir-host"
      ]
    },
    {
      "key": "nameserver",
      "label": "Основной DNS",
      "type": "select",
      "default": "https://cloudflare-dns.com/dns-query"
    },
    {
      "key": "fallback",
      "label": "Резервный DNS",
      "type": "select",
      "default": "https://dns.google/dns-query"
    },
    {
      "key": "route_dns",
      "label": "DNS по маршруту",
      "type": "boolean",
      "default": false,
      "help": "Прямые сайты используют отдельный DNS, остальные запросы идут через VPN."
    },
    {
      "key": "direct_nameserver",
      "label": "DNS напрямую",
      "type": "select",
      "default": "https://cloudflare-dns.com/dns-query"
    },
    {
      "key": "proxy_nameserver",
      "label": "DNS адреса VPN-сервера",
      "type": "select",
      "default": "https://cloudflare-dns.com/dns-query"
    },
    {
      "key": "bootstrap_nameserver",
      "label": "Начальный DNS",
      "type": "text",
      "default": "1.1.1.1",
      "help": "IP DNS или DoH по IP. Нужен для разрешения имён DNS-серверов."
    },
    {
      "key": "local_nameserver",
      "label": "DNS локальной сети",
      "type": "text",
      "default": "system",
      "help": "system — системный DNS; можно указать адрес роутера."
    },
    {
      "key": "ipv6",
      "label": "IPv6 в DNS",
      "type": "boolean",
      "default": false,
      "help": "Возвращать клиентам записи AAAA."
    },
    {
      "key": "prefer_h3",
      "label": "HTTP/3 для DoH",
      "type": "boolean",
      "default": false,
      "help": "Использовать HTTP/3, если DNS-провайдер его поддерживает."
    },
    {
      "key": "cache_algorithm",
      "label": "Кэш DNS",
      "type": "select",
      "default": "lru",
      "options": [
        {
          "value": "lru",
          "label": "LRU · совместимый"
        },
        {
          "value": "arc",
          "label": "ARC · адаптивный"
        }
      ]
    },
    {
      "key": "fake_ip_filter",
      "label": "Исключения Fake IP",
      "type": "textarea",
      "default": "*.lan\n*.local\ntime.*.com\nlocalhost.ptlogin2.qq.com",
      "help": "Домены, для которых Mihomo должен возвращать реальный IP."
    }
  ]
}
