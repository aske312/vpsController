{
  "id": "routing-policy",
  "name": "Маршрутизация",
  "version": "1.0.0",
  "installable": false,
  "automatic": true,
  "settings_only": true,
  "description": "Выбор primary/fallback и правила только внутри Mihomo.",
  "category": "routing",
  "category_name": "Маршрутизация",
  "default_enabled": false,
  "scope": "mihomo",
  "settings": [
    {
      "key": "mode",
      "label": "Режим",
      "type": "select",
      "default": "rule",
      "options": [
        "rule",
        "global"
      ]
    },
    {
      "key": "strategy",
      "label": "Стратегия каналов",
      "type": "select",
      "default": "fallback",
      "options": [
        "fallback",
        "url-test",
        "select"
      ]
    },
    {
      "key": "test_url",
      "label": "URL проверки",
      "type": "text",
      "default": "https://www.gstatic.com/generate_204"
    },
    {
      "key": "interval",
      "label": "Интервал, сек.",
      "type": "number",
      "default": 180,
      "min": 30,
      "max": 3600
    },
    {
      "key": "preset_primary",
      "label": "Основной транспорт пресетов",
      "type": "select",
      "default": "transport-reality",
      "options": [
        {"value": "transport-reality", "label": "VLESS"},
        {"value": "transport-awg", "label": "AmneziaWG"},
        {"value": "transport-wg", "label": "WireGuard"},
        {"value": "transport-shadowsocks", "label": "Shadowsocks"}
      ]
    },
    {
      "key": "preset_fallback",
      "label": "Резервный транспорт пресетов",
      "type": "select",
      "default": "transport-awg",
      "options": [
        {"value": "transport-awg", "label": "AmneziaWG"},
        {"value": "transport-reality", "label": "VLESS"},
        {"value": "transport-wg", "label": "WireGuard"},
        {"value": "transport-shadowsocks", "label": "Shadowsocks"}
      ]
    },
    {
      "key": "preset_cdn_domain",
      "label": "CDN-домен для быстрых профилей",
      "type": "text",
      "default": ""
    },
    { "key": "preset_tls_domain", "label": "Прямой TLS-домен для быстрых профилей", "type": "text", "default": "" },
    {
      "key": "block_ads",
      "label": "Блокировка рекламы",
      "type": "boolean",
      "default": false,
      "help": "Блокирует рекламные сети, трекеры и внешние anti-adblock-сервисы только в профилях, где включено это правило."
    },
    {
      "key": "direct_ru_sites",
      "label": "Российские сайты — напрямую",
      "type": "boolean",
      "default": false,
      "help": "Домены .ru, .рф, .su, основные российские сервисы и IP-адреса РФ будут открываться без VPN."
    },
    {
      "key": "direct_ru_banks",
      "label": "Российские банки — напрямую",
      "type": "boolean",
      "default": false,
      "help": "Сбер, Т-Банк, Альфа-Банк, ВТБ, Газпромбанк, Райффайзен, ПСБ и другие банки."
    },
    {
      "key": "direct_ru_marketplaces",
      "label": "Маркетплейсы — напрямую",
      "type": "boolean",
      "default": false,
      "help": "Ozon, Wildberries, Яндекс Маркет, Мегамаркет, Avito, AliExpress Россия и крупные интернет-магазины."
    },
    { "key": "block_ads_rules", "label": "Список блокировки рекламы", "type": "textarea", "default": "@default" },
    { "key": "direct_ru_sites_rules", "label": "Список российских сайтов", "type": "textarea", "default": "@default" },
    { "key": "direct_ru_banks_rules", "label": "Список банков и платежей", "type": "textarea", "default": "@default" },
    { "key": "direct_ru_marketplaces_rules", "label": "Список магазинов и маркетплейсов", "type": "textarea", "default": "@default" },
    {
      "key": "direct_games_enabled",
      "label": "Применять правило игр к профилю",
      "type": "boolean",
      "default": false,
      "help": "Включается отдельно в настройках каждого профиля."
    },
    {
      "key": "direct_games_udp_enabled",
      "label": "UDP выбранных игр без VPN",
      "type": "boolean",
      "default": false,
      "help": "Направляет напрямую только UDP-трафик процессов выбранных игр."
    },
    {
      "key": "direct_games",
      "label": "Игры без VPN",
      "type": "textarea",
      "default": "",
      "help": "Идентификаторы игр из встроенного списка, трафик процессов которых направляется напрямую."
    },
    {
      "key": "direct_game_processes",
      "label": "Дополнительные игровые процессы",
      "type": "textarea",
      "default": "",
      "help": "Имя процесса Windows/macOS или package name Android — по одному на строку."
    },
    {
      "key": "rules",
      "label": "Дополнительные правила (для опытных пользователей)",
      "type": "textarea",
      "default": "",
      "help": "По одному правилу Mihomo на строку. Готовые списки выше не нужно копировать сюда вручную."
    }
  ]
}
