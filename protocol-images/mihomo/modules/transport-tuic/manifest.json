{
  "id": "transport-tuic",
  "name": "TUIC",
  "version": "1.0.0",
  "installable": true,
  "description": "QUIC-транспорт TUIC v5 для подключений Mihomo.",
  "category": "transport",
  "category_name": "Каналы",
  "default_enabled": false,
  "scope": "mihomo",
  "service": "vps-control-mihomo-tuic.service",
  "supported_os": [
    "ubuntu",
    "debian"
  ],
  "preflight_packages": [
    "ca-certificates",
    "curl",
    "openssl",
    "python3",
    "tar"
  ],
  "minimum_free_mb": 128,
  "settings": [
    {
      "key": "port",
      "label": "UDP-порт",
      "type": "number",
      "default": 10443,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "congestion_control",
      "label": "Контроль перегрузки сервера",
      "type": "select",
      "default": "bbr",
      "options": [
        "bbr",
        "cubic",
        "new_reno"
      ]
    },
    {
      "key": "heartbeat",
      "label": "Heartbeat сервера",
      "type": "select",
      "default": "10s",
      "options": [
        "5s",
        "10s",
        "15s",
        "30s"
      ]
    }
  ],
  "connection_settings": [
    {
      "key": "congestion_control",
      "label": "Контроль перегрузки клиента",
      "type": "select",
      "default": "bbr",
      "options": [
        "bbr",
        "cubic",
        "new_reno"
      ]
    },
    {
      "key": "heartbeat",
      "label": "Heartbeat клиента",
      "type": "select",
      "default": "10s",
      "options": [
        "5s",
        "10s",
        "15s",
        "30s"
      ]
    },
    {
      "key": "udp_relay_mode",
      "label": "Передача UDP",
      "type": "select",
      "default": "native",
      "options": [
        "native",
        "quic"
      ]
    },
    {
      "key": "sni",
      "label": "TLS SNI",
      "type": "text",
      "default": "gate.312",
      "help": "Имя TLS-сервера. При проверке сертификата должно совпадать с его именем."
    },
    {
      "key": "skip_cert_verify",
      "label": "Разрешить самоподписанный сертификат",
      "type": "boolean",
      "default": true,
      "help": "Выключайте после установки доверенного сертификата для выбранного SNI."
    },
    {
      "key": "zero_rtt",
      "label": "0-RTT handshake",
      "type": "boolean",
      "default": false,
      "help": "Сокращает рукопожатие; ранние данные не защищены от повторного воспроизведения."
    }
  ]
}
