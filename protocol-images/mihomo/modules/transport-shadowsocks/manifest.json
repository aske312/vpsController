{
  "id": "transport-shadowsocks",
  "name": "Shadowsocks",
  "version": "1.0.0",
  "installable": true,
  "description": "Собственные Shadowsocks-инстансы Mihomo; direct-клиенты не используются.",
  "category": "transport",
  "category_name": "Каналы",
  "default_enabled": false,
  "scope": "mihomo",
  "supported_os": ["ubuntu", "debian"],
  "preflight_packages": ["shadowsocks-libev"],
  "minimum_free_mb": 128,
  "requires_kernel_headers": false,
  "package": "shadowsocks-libev",
  "settings": [
    {
      "key": "port_start",
      "label": "Начальный TCP/UDP-порт",
      "type": "number",
      "default": 31000,
      "min": 1024,
      "max": 64000
    },
    {
      "key": "method",
      "label": "Шифр",
      "type": "select",
      "default": "chacha20-ietf-poly1305",
      "options": [
        "chacha20-ietf-poly1305",
        "aes-256-gcm",
        "aes-128-gcm"
      ]
    }
  ]
}
