{
  "id": "transport-wg",
  "name": "WireGuard",
  "version": "1.0.0",
  "installable": true,
  "description": "Сервер WireGuard для подключений Mihomo.",
  "category": "transport",
  "category_name": "Каналы",
  "default_enabled": false,
  "scope": "mihomo",
  "service": "wg-quick@mh-wg0.service",
  "supported_os": [
    "ubuntu",
    "debian"
  ],
  "preflight_packages": [
    "iptables",
    "wireguard-tools"
  ],
  "minimum_free_mb": 128,
  "requires_kernel_headers": false,
  "package": "wireguard-tools",
  "settings": [
    {
      "key": "port",
      "label": "UDP-порт",
      "type": "number",
      "default": 51830,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "subnet",
      "label": "Подсеть",
      "type": "text",
      "default": "10.82.0.0/24"
    },
    {
      "key": "mtu",
      "label": "MTU серверного интерфейса",
      "type": "number",
      "default": 1280,
      "min": 1280,
      "max": 1420
    }
  ],
  "connection_settings": [
    {
      "key": "mtu",
      "label": "MTU клиента",
      "type": "number",
      "default": 1280,
      "min": 1280,
      "max": 1420,
      "help": "Размер пакета на устройстве. Серверный интерфейс настраивается в Компонентах."
    },
    {
      "key": "keepalive",
      "label": "Keepalive клиента, с",
      "type": "number",
      "default": 25,
      "min": 0,
      "max": 120,
      "help": "0 — отключить. Поддерживает NAT-сопоставление при простое."
    },
    {
      "key": "ip_version",
      "label": "IP-версия подключения",
      "type": "select",
      "default": "dual",
      "formats": [
        "mihomo"
      ],
      "export_key": "ip-version",
      "help": "Для клиента Mihomo. ",
      "options": [
        "dual",
        "ipv4",
        "ipv6",
        "ipv4-prefer",
        "ipv6-prefer"
      ]
    }
  ]
}
