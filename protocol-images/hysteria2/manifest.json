{
  "id": "hysteria2",
  "name": "Hysteria2",
  "version": "2.12.2",
  "installable": true,
  "description": "QUIC-прокси с отдельной учётной записью и статистикой для каждого подключения",
  "category": "secure-tunnels",
  "category_name": "Защищённые туннели",
  "installer": "install.sh",
  "uninstaller": "uninstall.sh",
  "supported_os": [
    "ubuntu",
    "debian"
  ],
  "preflight_packages": [
    "ca-certificates",
    "curl",
    "iptables",
    "openssl"
  ],
  "minimum_free_mb": 192,
  "requires_kernel_headers": false,
  "service": "vps-control-hysteria2.service",
  "installation": {
    "required_paths": [
      {
        "path": "/etc/vps-control/hysteria2/config.yaml"
      },
      {
        "path": "/etc/vps-control/hysteria2/settings.json"
      }
    ],
    "backup_paths": [
      {
        "path": "/etc/vps-control/hysteria2"
      },
      {
        "path": "/etc/systemd/system/vps-control-hysteria2.service"
      },
      {
        "path": "/etc/vps-control/environment",
        "env": "ENV_FILE"
      },
      {
        "path": "{data_dir}/clients.json"
      }
    ],
    "data_paths": [
      {
        "path": "/etc/vps-control/hysteria2"
      }
    ]
  }
}
