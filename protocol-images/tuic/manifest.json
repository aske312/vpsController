{
  "id": "tuic",
  "name": "TUIC v5",
  "version": "1.14.2",
  "installable": true,
  "description": "QUIC/UDP-прокси TUIC v5 с TLS и индивидуальной UUID-аутентификацией",
  "category": "secure-tunnels",
  "category_name": "Защищённые туннели",
  "installer": "install.sh",
  "uninstaller": "uninstall.sh",
  "supported_os": ["ubuntu", "debian"],
  "preflight_packages": ["ca-certificates", "curl", "iptables", "openssl", "tar"],
  "minimum_free_mb": 192,
  "requires_kernel_headers": false,
  "service": "vps-control-tuic.service",
  "installation": {
    "required_paths": [{"path": "/etc/vps-control/tuic/config.json"}, {"path": "/etc/vps-control/tuic/settings.json"}],
    "backup_paths": [{"path": "/etc/vps-control/tuic"}, {"path": "/etc/systemd/system/vps-control-tuic.service"}, {"path": "{data_dir}/clients.json"}],
    "data_paths": [{"path": "/etc/vps-control/tuic"}]
  }
}
