{
  "id": "wg",
  "name": "WireGuard",
  "version": "1.0.0",
  "installable": true,
  "description": "Быстрый VPN-туннель с маршрутизацией и NAT",
  "category": "secure-tunnels",
  "category_name": "Защищённые туннели",
  "installer": "install.sh",
  "uninstaller": "uninstall.sh",
  "supported_os": [
    "ubuntu",
    "debian"
  ],
  "preflight_packages": [
    "iptables",
    "wireguard-tools"
  ],
  "minimum_free_mb": 128,
  "requires_kernel_headers": false,
  "interface_env": "WG_INTERFACE",
  "service": "wg-quick@{interface}.service",
  "package": "wireguard-tools",
  "installation": {
    "required_paths": [
      {
        "path": "/etc/wireguard/{interface}.conf",
        "env": "WG_CONFIG"
      }
    ],
    "backup_paths": [
      {
        "path": "/etc/wireguard/{interface}.conf",
        "env": "WG_CONFIG"
      },
      {
        "path": "/etc/systemd/system/wg-quick@{interface}.service"
      },
      {
        "path": "/etc/vps-control/environment",
        "env": "ENV_FILE"
      },
      {
        "path": "{data_dir}/clients.json"
      }
    ],
    "data_paths": [
      {
        "path": "/etc/wireguard/{interface}.conf",
        "env": "WG_CONFIG"
      }
    ]
  }
}
