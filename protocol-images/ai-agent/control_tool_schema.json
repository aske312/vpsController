{
  "additionalProperties": false,
  "properties": {
    "name": {
      "enum": [
        "telegram_prepare",
        "vps_overview",
        "vps_services",
        "vps_components",
        "vps_metrics",
        "vps_panel",
        "vps_service_action",
        "vps_operation",
        "vps_api",
        "vps_user",
        "mihomo_user",
        "mihomo_capabilities",
        "mihomo_api",
        "mihomo_compare",
        "mihomo_operation",
        "vps_logs",
        "vps_network",
        "vps_security",
        "vps_diagnostics",
        "vps_access",
        "vps_observability",
        "vps_changes",
        "vps_incident",
        "vps_probe",
        "vps_compare",
        "application_diagnostics",
        "operation_timeline",
        "integration_probe",
        "diagnostic_baseline",
        "diagnostic_alerts",
        "diagnostic_alert_rules",
        "component_check",
        "vps_terminal",
        "operation_inventory",
        "developer_inspect",
        "relay_read",
        "relay_prepare"
      ],
      "title": "Name",
      "type": "string"
    },
    "service": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service"
    },
    "action": {
      "anyOf": [
        {
          "enum": [
            "start",
            "stop",
            "restart"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action"
    },
    "operation_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation Id"
    },
    "method": {
      "default": "GET",
      "enum": [
        "GET",
        "POST",
        "PATCH",
        "DELETE"
      ],
      "title": "Method",
      "type": "string"
    },
    "path": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "body": {
      "additionalProperties": true,
      "title": "Body",
      "type": "object"
    },
    "lines": {
      "default": 60,
      "maximum": 120,
      "minimum": 20,
      "title": "Lines",
      "type": "integer"
    },
    "endpoint": {
      "anyOf": [
        {
          "enum": [
            "/overview",
            "/services",
            "/components",
            "/metrics",
            "/application",
            "/logs",
            "/network",
            "/security",
            "/diagnostics"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Endpoint"
    }
  },
  "required": [
    "name"
  ],
  "title": "ToolCall",
  "type": "object"
}
