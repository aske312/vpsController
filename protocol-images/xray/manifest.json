{
  "id": "xray",
  "name": "Xray",
  "version": "latest-stable",
  "installable": true,
  "description": "Xray-core: VLESS поверх XHTTP с транспортной защитой REALITY/TLS",
  "category": "secure-tunnels",
  "category_name": "Защищённые туннели",
  "kind": "tunnel",
  "installer": "install.sh",
  "uninstaller": "uninstall.sh",
  "supported_os": ["ubuntu", "debian"],
  "preflight_packages": ["ca-certificates", "curl", "iptables", "openssl", "unzip"],
  "minimum_free_mb": 192,
  "requires_kernel_headers": false,
  "service": "vps-control-xray.service",
  "installation": {
    "required_paths": [{"path": "/etc/vps-control/xray/config.json"}, {"path": "/etc/vps-control/xray/settings.json"}],
    "backup_paths": [{"path": "/etc/vps-control/xray"}, {"path": "/etc/systemd/system/vps-control-xray.service"}, {"path": "{data_dir}/clients.json"}],
    "data_paths": [{"path": "/etc/vps-control/xray"}]
  }
}
