{
  "id": "trojan",
  "name": "Trojan",
  "version": "1.14.0",
  "installable": true,
  "description": "TLS-прокси с отдельным паролем для каждого подключения",
  "category": "secure-tunnels",
  "category_name": "Защищённые туннели",
  "installer": "install.sh",
  "uninstaller": "uninstall.sh",
  "supported_os": [
    "ubuntu",
    "debian"
  ],
  "preflight_packages": [
    "ca-certificates",
    "curl",
    "iptables",
    "openssl",
    "tar"
  ],
  "minimum_free_mb": 192,
  "requires_kernel_headers": false,
  "service": "vps-control-trojan.service",
  "installation": {
    "required_paths": [
      {
        "path": "/etc/vps-control/trojan/config.json"
      },
      {
        "path": "/etc/vps-control/trojan/settings.json"
      }
    ],
    "backup_paths": [
      {
        "path": "/etc/vps-control/trojan"
      },
      {
        "path": "/etc/systemd/system/vps-control-trojan.service"
      },
      {
        "path": "/etc/vps-control/environment",
        "env": "ENV_FILE"
      },
      {
        "path": "{data_dir}/clients.json"
      }
    ],
    "data_paths": [
      {
        "path": "/etc/vps-control/trojan"
      }
    ]
  }
}
