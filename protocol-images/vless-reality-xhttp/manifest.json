{
  "id": "vless-reality-xhttp",
  "name": "VLESS",
  "version": "1.2.1",
  "installable": true,
  "description": "Три независимых контура VLESS на Xray: REALITY, прямой TLS и CDN",
  "category": "secure-tunnels",
  "category_name": "Защищённые туннели",
  "installer": "install.sh",
  "uninstaller": "uninstall.sh",
  "supported_os": [
    "ubuntu",
    "debian"
  ],
  "preflight_packages": [
    "ca-certificates",
    "curl",
    "iptables",
    "openssl",
    "unzip"
  ],
  "minimum_free_mb": 256,
  "requires_kernel_headers": false,
  "service": "vps-control-vless-reality-xhttp.service",
  "installation": {
    "required_paths": [
      {
        "path": "/etc/vps-control/vless-reality-xhttp/config.json"
      },
      {
        "path": "/etc/vps-control/vless-reality-xhttp/reality.env"
      }
    ],
    "backup_paths": [
      {
        "path": "/etc/vps-control/vless-reality-xhttp"
      },
      {
        "path": "/etc/caddy/vps-control.d/vless-cdn.caddy"
      },
      {
        "path": "/etc/systemd/system/vps-control-vless-reality-xhttp.service"
      },
      {
        "path": "/etc/vps-control/environment",
        "env": "ENV_FILE"
      },
      {
        "path": "{data_dir}/clients.json"
      }
    ],
    "data_paths": [
      {
        "path": "/etc/vps-control/vless-reality-xhttp"
      }
    ]
  }
}
