ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SERVER_NAME=Unknown_location
PUBLIC_IP=
SERVER_CITY=Unknown
SERVER_COUNTRY=Unknown
SERVER_COUNTRY_CODE=
# Необязательно: подтверждённая локация имеет приоритет над неточными GeoIP-базами.
SERVER_CITY_OVERRIDE=
SERVER_COUNTRY_OVERRIDE=
SERVER_COUNTRY_CODE_OVERRIDE=
USER_ADMIN=admin
PWD_ADMIN=replace-with-a-strong-password
CORS_ORIGINS=http://127.0.0.1
PANEL_HOST=127.0.0.1
HTTP_PORT=80
ACCESS_MODE=external
WG_INTERFACE=wg0
AWG_INTERFACE=awg0
WG_PORT=51820
AWG_PORT=51822
WG_SUBNET=10.72.0.0/24
AWG_SUBNET=10.73.0.0/24
WG_CONFIG=/etc/wireguard/wg0.conf
AWG_CONFIG=/etc/amnezia/amneziawg/awg0.conf
AWG_MTU=1280
AWG_JC=6
AWG_JMIN=8
AWG_JMAX=80
AWG_S1=64
AWG_S2=112
AWG_H1=150000000
AWG_H2=600000000
AWG_H3=1000000000
AWG_H4=1400000000
DATA_DIR=/var/lib/vps-control
