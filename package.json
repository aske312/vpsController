{
  "name": "312-net-control",
  "version": "0.2.6",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.runtime/wrangler/wrangler.log vinext dev",
    "build": "vinext build",
    "start": "WRANGLER_LOG_PATH=.runtime/wrangler/wrangler.log vinext start",
    "test": "node --experimental-strip-types --test tests/web/*.test.mjs tests/contracts/*.test.mjs",
    "test:ui": "node --experimental-strip-types --test tests/web/*.test.mjs",
    "lint:ui": "eslint app src --cache --cache-strategy content --cache-location .runtime/eslint-ui-cache",
    "check:preview": "npm run lint:ui && npm run typecheck && npm run test:ui",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:full": "npm run check && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --cache --cache-strategy content --cache-location .runtime/eslint-cache"
  },
  "dependencies": {
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.134.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.4",
    "vinext": {
      "image-size": "2.0.4"
    }
  },
  "type": "module"
}
